#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")/.."
source scripts/env.sh
: "${ANDROID_SERIAL:?Set ANDROID_SERIAL to an emulator serial.}"
[[ "$ANDROID_SERIAL" == emulator-* ]] || { echo 'Media smoke is emulator-only'; exit 1; }
./gradlew assembleRelease --console=plain > build/media-smoke-build.log 2>&1
python3 -u scripts/media-smoke.py
