<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <queries>
        <package android:name="com.google.android.youtube.tvunplugged" />
        <package android:name="org.jellyfin.androidtv" />
        <package android:name="com.netflix.ninja" />
        <package android:name="com.google.android.youtube.tv" />
        <package android:name="com.hulu.livingroomplus" />
        <package android:name="com.wbd.stream" />
        <package android:name="com.apple.atve.androidtv.appletv" />
        <package android:name="tv.twitch.android.app" />
        <package android:name="com.spotify.tv.android" />
        <package android:name="com.amazon.amazonvideo.livingroom" />
        <package android:name="com.android.vending" />
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LEANBACK_LAUNCHER" /></intent>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent>
    </queries>
    <!-- Back gesture opt-in is ignored on the API 28 TV. -->
    <application tools:ignore="UnusedAttribute" android:enableOnBackInvokedCallback="true" android:allowBackup="false" android:fullBackupContent="false" android:dataExtractionRules="@xml/data_extraction_rules" android:label="Palmyra" android:banner="@drawable/banner" android:icon="@drawable/ic_launcher" android:supportsRtl="true" android:theme="@style/AppTheme">
        <activity android:name=".HomeActivity" android:exported="true" android:launchMode="singleTask" android:stateNotNeeded="true" android:excludeFromRecents="true" android:screenOrientation="landscape" tools:ignore="DiscouragedApi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".AllAppsActivity" android:exported="false" android:screenOrientation="landscape" tools:ignore="DiscouragedApi" />
        <service android:name=".MediaAccessService" android:label="@string/media_access" android:exported="true" android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter><action android:name="android.service.notification.NotificationListenerService" /></intent-filter>
        </service>
    </application>
</manifest>
